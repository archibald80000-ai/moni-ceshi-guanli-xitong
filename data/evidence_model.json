{
  "版本": "EVIDENCE-LAYERS-1",
  "用途": "区分计划、正式诏书、游戏结果、当前数据库和事后修订方案",
  "层级": {
    "L1_PLAN": {"名称": "准备计划", "可直接更新当前事实": false},
    "L2_ORDER": {"名称": "正式诏书", "可直接更新当前事实": false, "说明": "只证明已下令"},
    "L3_RESULT": {"名称": "游戏结果", "可直接更新当前事实": true, "说明": "须为正式朝政纪要、游戏截图或明确反馈"},
    "L4_STATE": {"名称": "当前数据库", "可直接更新当前事实": true, "说明": "必须可追溯到L3"},
    "L5_REVISION": {"名称": "事后修订方案", "可直接更新当前事实": false}
  },
  "必填字段": [
    "记录对象",
    "层级",
    "所属季度",
    "状态",
    "指标名称",
    "数值",
    "单位",
    "来源文件",
    "由谁确认",
    "可否写入当前事实"
  ],
  "不得混用": [
    ["计划目标", "实际结果"],
    ["诏书底线", "实际结果"],
    ["当季增量", "期末库存"],
    ["年产能力", "当季产量"],
    ["编制", "实到"],
    ["候任或署理", "正式任命或到任"]
  ],
  "当前门槛": "L4记录必须具有L3来源；没有正式结果时使用待反馈，不得用L1、L2或L5补造。"
}
